<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="500.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.easv.easvbar.gui.AddUserController">
    <children>
        <VBox alignment="CENTER" maxWidth="350.0" spacing="20.0">
            <children>
                <Label styleClass="login-title" text="Add User">
                    <font>
                        <Font name="System Bold" size="32.0" />
                    </font>
                </Label>

                <VBox spacing="10.0">
                    <children>
                        <TextField fx:id="usernameField" prefHeight="50.0" promptText="Username" styleClass="login-input">
                            <font>
                                <Font size="18.0" />
                            </font>
                        </TextField>
                        <TextField fx:id="passwordField" prefHeight="50.0" promptText="Password" styleClass="login-input">
                            <font>
                                <Font size="18.0" />
                            </font>
                        </TextField>
                        <TextField fx:id="emailField" prefHeight="50.0" promptText="Email" styleClass="login-input">
                            <font>
                                <Font size="18.0" />
                            </font>
                        </TextField>
                        <TextField fx:id="roleField" prefHeight="50.0" promptText="Role (ADMIN/COORDINATOR)" styleClass="login-input">
                            <font>
                                <Font size="18.0" />
                            </font>
                        </TextField>
                    </children>
                </VBox>

                <HBox alignment="CENTER" spacing="20.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#cancel" prefHeight="40.0" prefWidth="120.0" styleClass="sign-in-button" text="Cancel">
                            <font>
                                <Font size="16.0" />
                            </font>
                        </Button>
                        <Button fx:id="saveButton" mnemonicParsing="false" onAction="#addUser" prefHeight="40.0" prefWidth="120.0" styleClass="sign-in-button" text="Add">
                            <font>
                                <Font size="16.0" />
                            </font>
                        </Button>
                    </children>
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </HBox>
            </children>
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>
        </VBox>
    </children>
</StackPane>
