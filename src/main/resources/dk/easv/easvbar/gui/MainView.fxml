<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/24.0.1" fx:controller="dk.easv.easvbar.gui.MainController">

    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>

    <!-- Верхняя панель -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Events at EASV:" />

        <Region HBox.hgrow="ALWAYS" />

        <Button onAction="#onLoginClick" styleClass="logout-button" text="Log In" />
    </HBox>

    <!-- Список мероприятий -->
    <ScrollPane fitToWidth="true">
        <content>
            <VBox fx:id="eventContainer" spacing="15" />
        </content>
    </ScrollPane>

</VBox>
