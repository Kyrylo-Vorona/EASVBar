<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="450.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.easv.easvbar.gui.BuyTicketController">
    <children>
        <VBox alignment="CENTER" spacing="20" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">
            <padding><Insets bottom="40" left="50" right="50" top="40" /></padding>

            <Label style="-fx-font-size: 28; -fx-font-weight: bold;" styleClass="login-title" text="Buy ticket" />
            <Label style="-fx-font-size: 18;" styleClass="subtitle" text="Please fill the fields" />

            <TextField fx:id="nameField" maxWidth="400" prefHeight="50" prefWidth="400" promptText="Name" style="-fx-font-size: 16;" styleClass="login-input" />

            <TextField fx:id="emailField" maxWidth="400" prefHeight="50" prefWidth="400" promptText="Email" style="-fx-font-size: 16;" styleClass="login-input" />

            <VBox alignment="CENTER" spacing="15">
                <ComboBox fx:id="ticketTypeBox" maxWidth="400" prefHeight="50" prefWidth="400" promptText="Select ticket type" style="-fx-font-size: 16;" styleClass="combo-box" />

                <HBox alignment="CENTER" spacing="20">
                    <Button mnemonicParsing="false" onAction="#onCancelClick" prefHeight="50" prefWidth="190" style="-fx-font-size: 16;" styleClass="sign-in-button" text="Cancel" />

                    <Button mnemonicParsing="false" onAction="#onBuyTicketClick" prefHeight="50" prefWidth="190" style="-fx-font-size: 16; -fx-background-color: #7B68EE;" styleClass="sign-in-button" text="Buy ticket" />
                </HBox>
            </VBox>
        </VBox>
    </children>
</AnchorPane>
