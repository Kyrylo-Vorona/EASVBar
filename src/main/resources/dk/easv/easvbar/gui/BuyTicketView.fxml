<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="dk.easv.easvbar.gui.BuyTicketController">
    <children>
        <VBox alignment="CENTER" spacing="15" AnchorPane.topAnchor="0"
              AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
              AnchorPane.rightAnchor="0">
            <padding><Insets top="30" bottom="30" left="40" right="40"/></padding>

            <Label styleClass="login-title" text="Buy ticket" style="-fx-font-size: 24;"/>
            <Label styleClass="subtitle" text="Please fill the fields" style="-fx-font-size: 18;"/>

            <TextField fx:id="nameField" prefWidth="300" maxWidth="300" prefHeight="45"
                       promptText="Name" styleClass="login-input"/>
            <TextField fx:id="emailField" prefWidth="300" maxWidth="300" prefHeight="45"
                       promptText="Email" styleClass="login-input"/>

            <HBox spacing="10" alignment="CENTER">
                <ComboBox fx:id="ticketTypeBox" prefWidth="130" prefHeight="43"
                          promptText="Standard" styleClass="combo-box"/>
                <Button mnemonicParsing="false" styleClass="sign-in-button"
                        text="Cancel" onAction="#onCancelClick"/>
                <Button mnemonicParsing="false" prefWidth="130" prefHeight="43"
                        styleClass="sign-in-button" text="Buy ticket"
                        onAction="#onBuyTicketClick"/>
            </HBox>
        </VBox>
    </children>
</AnchorPane>
