<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.easv.easvbar.gui.CreateEventController">
    <children>
        <VBox alignment="TOP_CENTER" spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="20.0" left="40.0" right="40.0" top="20.0" />
            </padding>
            <children>
                <Label styleClass="login-title" text="Create Event">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>

                <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                    <children>
                        <TextField fx:id="txtName" prefHeight="40.0" promptText="Event Name (Required)" styleClass="login-input" />

                        <HBox spacing="10.0">
                            <children>
                                <TextField fx:id="txtStartDate" prefHeight="40.0" promptText="Start Date/Time" styleClass="login-input" HBox.hgrow="ALWAYS" />
                                <TextField fx:id="txtEndDate" prefHeight="40.0" promptText="End Date/Time (Optional)" styleClass="login-input" HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>

                        <TextField fx:id="txtLocation" prefHeight="40.0" promptText="Location (Address/URL)" styleClass="login-input" />

                        <TextField fx:id="txtLocationGuidance" prefHeight="40.0" promptText="Location Guidance (Optional)" styleClass="login-input" />

                        <TextArea fx:id="txtNotes" prefHeight="100.0" promptText="Notes / Extra Information" styleClass="description-textarea" wrapText="true" VBox.vgrow="ALWAYS" />

                        <TextField fx:id="txtPrice" prefHeight="40.0" promptText="Price for standart ticket (DKK)" styleClass="login-input" />
                    </children>
                </VBox>

                <HBox alignment="CENTER_RIGHT" spacing="15.0">
                    <children>
                        <Button mnemonicParsing="false" onAction="#handleCancel" prefWidth="100.0" styleClass="sign-in-button" text="Cancel" />
                        <Button fx:id="btnSave" mnemonicParsing="false" onAction="#handleCreateEvent" prefWidth="100.0" styleClass="sign-in-button" text="Create" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
