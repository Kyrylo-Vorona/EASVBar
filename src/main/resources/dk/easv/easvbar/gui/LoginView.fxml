<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="400.0" prefWidth="339.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.easv.easvbar.gui.LoginController">
   <children>
      <VBox alignment="CENTER" fillWidth="false" layoutY="59.0" spacing="5.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Label styleClass="login-title" text="Log In">
               <font>
                  <Font size="24.0" />
               </font>
            </Label>
            <TextField fx:id="username" prefHeight="76.0" prefWidth="213.0" promptText="Username" styleClass="login-input">
               <font>
                  <Font size="24.0" />
               </font>
            </TextField>
            <PasswordField fx:id="password" prefHeight="76.0" prefWidth="213.0" promptText="Password">
               <font>
                  <Font size="24.0" />
               </font>
            </PasswordField>
            <Button mnemonicParsing="false" onAction="#onLoginClick" prefHeight="79.0" prefWidth="213.0" styleClass="sign-in-button" text="Sign In">
               <font>
                  <Font size="24.0" />
               </font>
            </Button>
         </children>
      </VBox>
      <Button layoutX="23.0" layoutY="21.0" mnemonicParsing="false" onAction="#onBackClick" prefHeight="25.0" prefWidth="54.0" styleClass="back-button" text="Back">
         <font>
            <Font size="14.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
