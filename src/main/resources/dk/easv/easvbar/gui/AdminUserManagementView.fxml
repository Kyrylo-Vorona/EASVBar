<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="750.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.easv.easvbar.gui.AdminUserManagementController">
    <children>
        <VBox alignment="TOP_CENTER" spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="20.0" left="40.0" right="40.0" top="20.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label styleClass="main-title" text="Admin Dashboard">
                            <font>
                                <Font name="System Bold" size="28.0" />
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#logOut" styleClass="logout-button" text="Log Out">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT">
                    <children>
                        <Label styleClass="subtitle" text="User Management">
                            <font>
                                <Font size="20.0" />
                            </font>
                        </Label>
                    </children>
                </HBox>

                <HBox alignment="CENTER" spacing="10.0">
                    <children>
                        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#openAddUserView" prefHeight="45.0" styleClass="admin-button" text="Add User" HBox.hgrow="ALWAYS" />
                        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#openEditUserView" prefHeight="45.0" styleClass="admin-button" text="Edit User" HBox.hgrow="ALWAYS" />
                        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#deleteUser" prefHeight="45.0" styleClass="admin-button" text="Delete User" HBox.hgrow="ALWAYS" />
                        <Region prefWidth="30.0" />
                        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#backToEventManagement" prefHeight="45.0" styleClass="user-management-button" text="Event Management" HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>

                <TableView fx:id="userTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="usernameColumn" prefWidth="150.0" text="Username" />
                        <TableColumn fx:id="emailColumn" prefWidth="250.0" text="Email" />
                        <TableColumn fx:id="roleColumn" prefWidth="120.0" text="Role" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </children>
</AnchorPane>
