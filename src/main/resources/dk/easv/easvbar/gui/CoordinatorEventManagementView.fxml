<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="450.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.easv.easvbar.gui.CoordinatorEventManagementController">
    <children>
        <VBox prefHeight="700.0" prefWidth="450.0" spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <Label maxWidth="Infinity" styleClass="main-title" text="Coordinator" HBox.hgrow="ALWAYS">
                            <font>
                                <Font name="System Bold" size="24.0" />
                            </font>
                        </Label>
                        <Button mnemonicParsing="false" onAction="#logOut" styleClass="logout-button" text="Log Out" />
                    </children>
                </HBox>

                <Label styleClass="subtitle" text="Event Management">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Label>

                <VBox spacing="10.0">
                    <children>
                        <HBox spacing="10.0">
                            <children>
                                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#CreateEvent" prefHeight="40.0" styleClass="admin-button" text="Create Event" HBox.hgrow="ALWAYS" />
                                <Button maxWidth="Infinity" mnemonicParsing="false" prefHeight="40.0" styleClass="admin-button" text="Edit Event" HBox.hgrow="ALWAYS" />
                                <Button maxWidth="Infinity" mnemonicParsing="false" prefHeight="40.0" styleClass="admin-button" text="Delete" HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>
                        <HBox spacing="10.0">
                            <children>
                                <Button maxWidth="Infinity" mnemonicParsing="false" prefHeight="40.0" styleClass="admin-button" text="Assign Coord." HBox.hgrow="ALWAYS" />
                                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#backToTicketManagement" prefHeight="40.0" styleClass="user-management-button" text="Tickets management" HBox.hgrow="ALWAYS" />
                                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#openSoldTicketsView" prefHeight="40.0" styleClass="user-management-button" text="Sold Tickets" HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <TableView fx:id="eventTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="eventNameColumn" prefWidth="120.0" text="Event Name" />
                        <TableColumn fx:id="eventDateColumn" prefWidth="70.0" text="Date" />
                        <TableColumn fx:id="eventLocationColumn" prefWidth="100.0" text="Location" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </children>
</AnchorPane>
